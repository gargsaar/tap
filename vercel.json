{
  "cleanUrls": true,
  "buildCommand": "npx trigger.dev@latest deploy",
  "outputDirectory": "public",
  "functions": {
    "api/analyze.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "microphone=(self), display-capture=(self)" }
      ]
    }
  ]
}
